# Dedicated worker configuration. Copy outside Git and replace placeholders.
AI_DESCRIPTION_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_DESCRIPTION_VERSION=v1
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_VERSION=v1
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
LOCAL_AI_MIN_AVAILABLE_RAM_MB=3072

KDI_LOCAL_AI_TEMP_ROOT=C:\KDIWorkerTemp
KDI_LOCAL_AI_DISK_RESERVE_MB=51200
KDI_LOCAL_AI_MAX_ASSET_BYTES=21474836480
KDI_LOCAL_AI_DOWNLOAD_CHUNK_BYTES=8388608
KDI_LOCAL_AI_DOWNLOAD_TIMEOUT_SECONDS=900
KDI_LOCAL_AI_JOB_TIMEOUT_SECONDS=1200
KDI_LOCAL_AI_LEASE_SECONDS=1200
KDI_LOCAL_AI_POLL_SECONDS=5
KDI_LOCAL_AI_STAGING_PATH=C:\KDIWorkerState\semantic-worker-staging.jsonl
KDI_FFPROBE_TIMEOUT_SECONDS=30
KDI_FFMPEG_TIMEOUT_SECONDS=30
KDI_FFMPEG_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe
KDI_FFPROBE_PATH=C:\Program Files\ffmpeg\bin\ffprobe.exe

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_OUTSIDE_GIT
GOOGLE_DRIVE_SERVICE_ACCOUNT_CREDENTIALS_PATH=C:\KDIWorkerSecrets\drive-reader.json
DESTINATION_FOLDER_ID=REPLACE_KDI_MASTER_FOLDER_ID_OUTSIDE_GIT

# Keep disabled until the separately approved post-pilot queue milestone.
KDI_LOCAL_AI_QUEUE_ENABLED=false
