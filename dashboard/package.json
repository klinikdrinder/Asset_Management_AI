{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:staging": "next start -H 127.0.0.1 -p 3001",
    "test": "npm run unit && npm run build",
    "unit": "cross-env NODE_OPTIONS=--conditions=react-server tsx --test tests/safe-deployment.test.ts tests/conversation-search.test.ts tests/dashboard-utils.test.ts tests/environment.test.ts tests/folder-explorer.test.ts tests/media-library.test.ts tests/media-repository.test.ts tests/authentication.test.ts tests/custom-admin-auth.test.ts tests/email-password-auth.test.ts tests/firebase-admin-credentials.test.ts tests/dev-preview.test.ts tests/dev-library.test.ts tests/semantic-review.test.ts tests/simplified-frontend.test.ts tests/live-library.test.ts tests/library-search.test.ts tests/google-service-account.test.ts tests/google-drive-client.test.ts tests/resolve-asset-media-location.test.ts tests/media-range.test.ts tests/thumbnail-cache.test.ts tests/video-poster.test.ts tests/media-frontend-security.test.ts && cross-env NODE_OPTIONS= tsx --test tests/semantic-review-client.test.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "firebase:preflight": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/firebase-admin-preflight.ts",
    "supabase:preflight": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/supabase-trusted-client-preflight.ts",
    "library:reconcile": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/library-reconciliation.ts",
    "library:verify-dev": "cross-env NODE_ENV=development KDI_LIBRARY_DEV_BYPASS=true NODE_OPTIONS=--conditions=react-server tsx scripts/verify-dev-media-library.ts",
    "drive:verify": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-kdi-master-drive-access.ts",
    "db:generate": "drizzle-kit generate",
    "visual:test-model": "..\\.venv\\Scripts\\python.exe scripts\\test-openclip.py",
    "visual:service": "..\\.venv\\Scripts\\python.exe -m uvicorn visual_indexing.service:app --host 127.0.0.1 --port 8765",
    "visual:queue": "..\\.venv\\Scripts\\python.exe scripts\\visual-index.py queue",
    "visual:one": "..\\.venv\\Scripts\\python.exe scripts\\visual-index.py one",
    "visual:run": "..\\.venv\\Scripts\\python.exe scripts\\visual-index.py run",
    "visual:status": "..\\.venv\\Scripts\\python.exe scripts\\visual-index.py status",
    "visual:retry": "..\\.venv\\Scripts\\python.exe scripts\\visual-index.py retry",
    "visual:reconcile": "npx tsx scripts\\visual-database-reconciliation.ts",
    "visual:benchmark": "..\\.venv\\Scripts\\python.exe scripts\\visual-search-benchmark.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.6.2",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "7.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
