NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kdi-media-library.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kdi-media-library
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-configured-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
FIREBASE_PROJECT_ID=kdi-media-library
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Public\Asset_Management_AI\.secrets\firebase-admin.json
# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
KDI_LIBRARY_DEV_BYPASS=false
