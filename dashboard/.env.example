NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kdi-media-library.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kdi-media-library
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-configured-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
FIREBASE_PROJECT_ID=kdi-media-library
GOOGLE_APPLICATION_CREDENTIALS=../.secrets/firebase-admin.json
# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
# Optional Supabase Auth custom SMTP provisioning inputs. These are server/
# operator-only values consumed by scripts/configure-supabase-smtp.ts; never
# prefix them with NEXT_PUBLIC_ and never commit real values.
KDI_SMTP_HOST=
KDI_SMTP_PORT=587
KDI_SMTP_USERNAME=
KDI_SMTP_PASSWORD=
KDI_SMTP_SENDER_EMAIL=
KDI_SMTP_SENDER_NAME=KDI Media Library
KDI_LIBRARY_DEV_BYPASS=false
# TEMPORARY LOCAL AUTH BYPASS. Authentication must be restored before public deployment.
# Effective only for localhost/127.0.0.1/::1; production start binds to 127.0.0.1.
LOCAL_AUTH_BYPASS=false
# --- KDI Master Shared Drive media delivery (server only) ------------------
# Permanent thumbnail/preview/download architecture: app/media-service.ts ->
# app/lib/media/resolve-location.ts -> app/lib/google/ -> Google Drive API,
# using a service account (never OAuth user tokens, never manually copied
# access tokens). See app/lib/google/service-account.ts for the exact
# resolution order. Never prefix any of these with NEXT_PUBLIC_, never log
# their values, and never put a real credential in this example file.
#
# Google Cloud Shared Drive id of "KDI Master" (Drive UI: the segment after
# /drive/folders/ when browsing the Shared Drive's root).
KDI_MASTER_DRIVE_ID=replace-with-kdi-master-shared-drive-id
# Option A - dedicated Drive service account, discrete key-pair env vars
# (preferred: narrowest scope, independent of the Firebase Admin identity).
# Paste the private_key value as-is; both real newlines and the escaped
# "\n" form emitted by most secret managers are supported.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=replace-with-drive-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Option B - path to a service-account JSON key file, reusing this
# repository's existing GOOGLE_APPLICATION_CREDENTIALS convention (already
# used for Firebase Admin above) when a dedicated Drive service account
# lives in the same file/project. Only used when Option A is not set.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_CREDENTIALS_PATH=../.secrets/firebase-admin.json
# Local-first provider for natural-language query embeddings. If local
# inference is unavailable, search keeps text/metadata/filename ranking.
# Server only - never prefix these with NEXT_PUBLIC_. Must match the worker's
# provider/model/dimensions/version (root .env.example) exactly, since
# hybrid_search_assets only compares embeddings produced by the same
# provider/model/version. AI_DESCRIPTION_PROVIDER/OPENAI_DESCRIPTION_MODEL/
# OPENAI_DESCRIPTION_SCHEMA_VERSION are not used here - description
# generation only ever runs in the Python worker, never in this app.
AI_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_CONTEXT_LENGTH=2048
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_EMBEDDING_VERSION=v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_VERSION=v1
