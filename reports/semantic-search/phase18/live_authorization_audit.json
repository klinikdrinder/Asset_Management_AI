    {
      "schema_name": "private",
      "proname": "can_user_view_asset_for",
      "arguments": "p_user_id uuid, p_asset_id uuid",
      "security_definer": true,
      "proconfig": [
        "search_path=\"\""
      ],
      "definition": "CREATE OR REPLACE FUNCTION private.can_user_view_asset_for(p_user_id uuid, p_asset_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select exists(\n    select 1 from public.app_users u\n    join public.assets a on a.id=p_asset_id\n    join public.asset_access_control ac on ac.asset_id=a.id\n    where u.user_id=p_user_id and u.is_active\n      and a.upload_status not in ('FAILED','MISSING')\n      and private.is_asset_source_available(a.id)\n      and ac.internal_usage_status='ALLOWED'\n      and ac.sensitivity_level is not null\n      and ac.is_clinical is not null\n      and (\n        (ac.is_clinical=false\n          and coalesce(ac.requires_clinical_permission,false)=false\n          and ac.sensitivity_level in ('GENERAL','INTERNAL'))\n        or\n        (u.can_view_clinical=true and (\n          ac.is_clinical=true\n          or ac.requires_clinical_permission=true\n          or ac.sensitivity_level in ('RESTRICTED','CLINICAL','HIGHLY_RESTRICTED')\n        ))\n      )\n  );\n$function$\n",
      "execute_roles": [
        "service_role"
      ]
    },
    {
      "schema_name": "private",
      "proname": "current_app_user_id",
      "arguments": "",
      "security_definer": true,
      "proconfig": [
        "search_path=\"\""
      ],
      "definition": "CREATE OR REPLACE FUNCTION private.current_app_user_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n  select case\r\n    when (auth.jwt() ->> 'iss') = 'https://securetoken.google.com/kdi-media-library'\r\n      then (\r\n        select u.user_id from public.app_users u\r\n        where private.is_verified_firebase_identity()\r\n          and u.firebase_uid = (auth.jwt() ->> 'sub')\r\n        limit 1\r\n      )\r\n    when (auth.jwt() ->> 'iss') ~ '^https://wcqqjpndlwsvatjuqnol[.]supabase[.]co/auth/v1/?$'\r\n      then auth.uid()\r\n    else null\r\n  end;\r\n$function$\n",
      "execute_roles": [
        "anon",
        "authenticated",
        "service_role"
      ]
    },
