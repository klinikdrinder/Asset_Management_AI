SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REGION=ap-southeast-1
# Alternatively, copy the exact pooler hostname from Project Settings > Database:
# SUPABASE_DB_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_DRIVE_DESTINATION_TOKEN_FILE=secrets/google_drive_destination_write_token.json
DESTINATION_FOLDER_ID=replace-with-kdi-master-folder-id
SOURCE_FOLDER_NAME=replace-with-exact-source-name
DRY_RUN=true
# Local-first providers for scripts/run_semantic_indexing.py. Ollama stays on
# loopback and needs no cloud credential. OpenAI remains an explicit optional
# provider below; it is never an automatic fallback.
AI_DESCRIPTION_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_DESCRIPTION_VERSION=v1
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_CONTEXT_LENGTH=2048
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_EMBEDDING_VERSION=v1
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_MODELS=path/to/local/ollama/models
LOCAL_AI_MIN_AVAILABLE_RAM_MB=3072
OPENAI_API_KEY=
OPENAI_DESCRIPTION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_DESCRIPTION_SCHEMA_VERSION=v1
OPENAI_EMBEDDING_VERSION=v1
# Development-only server diagnostics for interpreted/ranked searches.
KDI_SEARCH_DEBUG=false
# Optional overrides. When unset, Python prefers .tools/ffmpeg/bin before PATH.
KDI_FFMPEG_PATH=
KDI_FFPROBE_PATH=
# Permanent read-only KDI Master path (normal My Drive folder).
GOOGLE_DRIVE_SERVICE_ACCOUNT_CREDENTIALS_PATH=.secrets/kdi-media-reader.json
