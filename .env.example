SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REGION=ap-southeast-1
# Alternatively, copy the exact pooler hostname from Project Settings > Database:
# SUPABASE_DB_POOLER_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_DRIVE_DESTINATION_TOKEN_FILE=secrets/google_drive_destination_write_token.json
DESTINATION_FOLDER_ID=replace-with-kdi-master-folder-id
SOURCE_FOLDER_NAME=replace-with-exact-source-name
DRY_RUN=true
